ARCH|    input [31:0] data4In;
ARCH|    input [31:0] data5In;
ARCH|    input [31:0] data6In;
ARCH|    input [31:0] data7In;
ARCH|    input        lineEnable0In;
ARCH|    input        lineEnable1In;
ARCH|    input        lineEnable2In;
ARCH|    input        lineEnable3In;
ARCH|    input        lineEnable4In;
ARCH|    input        lineEnable5In;
ARCH|    input        lineEnable6In;
ARCH|    input        lineEnable7In;
ARCH|    input        tick;
ARCH|    input        we;
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The outputs are defined here                                               **
ARCH|    *******************************************************************************/
ARCH|    output [31:0] data0Out;
ARCH|    output [31:0] data1Out;
ARCH|    output [31:0] data2Out;
ARCH|    output [31:0] data3Out;
ARCH|    output [31:0] data4Out;
ARCH|    output [31:0] data5Out;
ARCH|    output [31:0] data6Out;
ARCH|    output [31:0] data7Out;
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The wires are defined here                                                 **
ARCH|    *******************************************************************************/
ARCH|    wire [7:0] s_ramReadAddress;
ARCH|    wire       s_ramWe;
ARCH|    wire [7:0] s_ramWriteAddress;
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The registers are defined here                                             **
ARCH|    *******************************************************************************/
ARCH|    reg [8:0]  s_addressOffsetReg;
ARCH|    reg [31:0] s_dataIn0Reg;
ARCH|    reg [31:0] s_dataIn1Reg;
ARCH|    reg [31:0] s_dataIn2Reg;
ARCH|    reg [31:0] s_dataIn3Reg;
ARCH|    reg [31:0] s_dataIn4Reg;
ARCH|    reg [31:0] s_dataIn5Reg;
ARCH|    reg [31:0] s_dataIn6Reg;
ARCH|    reg [31:0] s_dataIn7Reg;
ARCH|    reg [31:0] s_dataOut0Reg;
ARCH|    reg [31:0] s_dataOut1Reg;
ARCH|    reg [31:0] s_dataOut2Reg;
ARCH|    reg [31:0] s_dataOut3Reg;
ARCH|    reg [31:0] s_dataOut4Reg;
ARCH|    reg [31:0] s_dataOut5Reg;
ARCH|    reg [31:0] s_dataOut6Reg;
ARCH|    reg [31:0] s_dataOut7Reg;
ARCH|    reg        s_lineEnable0Reg;
ARCH|    reg        s_lineEnable1Reg;
ARCH|    reg        s_lineEnable2Reg;
ARCH|    reg        s_lineEnable3Reg;
ARCH|    reg        s_lineEnable4Reg;
ARCH|    reg        s_lineEnable5Reg;
ARCH|    reg        s_lineEnable6Reg;
ARCH|    reg        s_lineEnable7Reg;
ARCH|    reg [31:0] s_ramDataIn;
ARCH|    reg [31:0] s_ramDataOut;
ARCH|    reg [7:0]  s_readAddressReg;
ARCH|    reg [8:0]  s_tickDelayReg;
ARCH|    reg        s_weReg;
ARCH|    reg [7:0]  s_writeAddressReg;
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The type defined signals are defined here                                  **
ARCH|    *******************************************************************************/
ARCH|    memoryArray s_memContents;
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The module functionality is described here                                 **
ARCH|    *******************************************************************************/
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The synchronous semi-dual-ported memory is defined here                    **
ARCH|    *******************************************************************************/
ARCH|    assign s_ramWriteAddress = s_writeAddressReg + s_addressOffsetReg[7:0];
ARCH|    assign s_ramReadAddress = s_readAddressReg + s_addressOffsetReg[7:0];
ARCH| 
ARCH|    always @(posedge clock)
ARCH|      if (s_ramWe == 1'b1) s_memContents[s_ramWriteAddress] <= s_ramDataIn;
ARCH| 
ARCH|    always @(negedge clock)
ARCH|      s_ramDataOut <= s_memContents[s_ramReadAddress];
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The input registers are defined here                                       **
ARCH|    *******************************************************************************/
ARCH|    always @(posedge clock)
ARCH|      begin
ARCH|        if (s_tickDelayReg[0] == 1'b1)
ARCH|          s_readAddressReg <= address;
ARCH|        if (tick == 1'b1)
ARCH|          begin
ARCH|            s_writeAddressReg     <= address;
ARCH|            s_weReg               <= we;
ARCH|            s_dataIn0Reg     <= data0In;
ARCH|            s_lineEnable0Reg <= lineEnable0In;
ARCH|            s_dataIn1Reg     <= data1In;
ARCH|            s_lineEnable1Reg <= lineEnable1In;
ARCH|            s_dataIn2Reg     <= data2In;
ARCH|            s_lineEnable2Reg <= lineEnable2In;
ARCH|            s_dataIn3Reg     <= data3In;
ARCH|            s_lineEnable3Reg <= lineEnable3In;
ARCH|            s_dataIn4Reg     <= data4In;
ARCH|            s_lineEnable4Reg <= lineEnable4In;
ARCH|            s_dataIn5Reg     <= data5In;
ARCH|            s_lineEnable5Reg <= lineEnable5In;
ARCH|            s_dataIn6Reg     <= data6In;
ARCH|            s_lineEnable6Reg <= lineEnable6In;
ARCH|            s_dataIn7Reg     <= data7In;
ARCH|            s_lineEnable7Reg <= lineEnable7In;
ARCH|          end
ARCH|        end
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The FSM's are defined here                                                 **
ARCH|    *******************************************************************************/
ARCH|    always @(posedge clock)
ARCH|      begin
ARCH|        s_tickDelayReg[0] <= tick;
ARCH|        s_tickDelayReg[8:1] <= s_tickDelayReg[7:0];
ARCH|        s_addressOffsetReg <= (s_tickDelayReg[0] == 1'b1) ? 9'd0 :
ARCH|                              s_addressOffsetReg != 9'd8 ? s_addressOffsetReg + 9'd1 :
ARCH|                              s_addressOffsetReg;
ARCH|      end
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** Here the RamDatIn is defined                                               **
ARCH|    *******************************************************************************/
ARCH|    always @*
ARCH|      case (s_addressOffsetReg)
ARCH|        9'd7    : s_ramDataIn <= s_dataIn7Reg;
ARCH|        9'd6    : s_ramDataIn <= s_dataIn6Reg;
ARCH|        9'd5    : s_ramDataIn <= s_dataIn5Reg;
ARCH|        9'd4    : s_ramDataIn <= s_dataIn4Reg;
ARCH|        9'd3    : s_ramDataIn <= s_dataIn3Reg;
ARCH|        9'd2    : s_ramDataIn <= s_dataIn2Reg;
ARCH|        9'd1    : s_ramDataIn <= s_dataIn1Reg;
ARCH|        default : s_ramDataIn <= s_dataIn0Reg;
ARCH|      endcase;
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** Here the RamDatout is defined                                              **
ARCH|    *******************************************************************************/
ARCH|    assign data0Out = s_dataOut0Reg;
ARCH|    assign data1Out = s_dataOut1Reg;
ARCH|    assign data2Out = s_dataOut2Reg;
ARCH|    assign data3Out = s_dataOut3Reg;
ARCH|    assign data4Out = s_dataOut4Reg;
ARCH|    assign data5Out = s_dataOut5Reg;
ARCH|    assign data6Out = s_dataOut6Reg;
ARCH|    assign data7Out = s_dataOut7Reg;
ARCH| 
ARCH|    always @(posedge clock)
ARCH|      begin
ARCH|        s_dataOut0Reg <= (s_tickDelayReg[1] == 1'b1) ? s_ramDataOut : s_dataOut0Reg;
ARCH|        s_dataOut1Reg <= (s_tickDelayReg[2] == 1'b1) ? s_ramDataOut : s_dataOut1Reg;
ARCH|        s_dataOut2Reg <= (s_tickDelayReg[3] == 1'b1) ? s_ramDataOut : s_dataOut2Reg;
ARCH|        s_dataOut3Reg <= (s_tickDelayReg[4] == 1'b1) ? s_ramDataOut : s_dataOut3Reg;
ARCH|        s_dataOut4Reg <= (s_tickDelayReg[5] == 1'b1) ? s_ramDataOut : s_dataOut4Reg;
ARCH|        s_dataOut5Reg <= (s_tickDelayReg[6] == 1'b1) ? s_ramDataOut : s_dataOut5Reg;
ARCH|        s_dataOut6Reg <= (s_tickDelayReg[7] == 1'b1) ? s_ramDataOut : s_dataOut6Reg;
ARCH|        s_dataOut7Reg <= (s_tickDelayReg[8] == 1'b1) ? s_ramDataOut : s_dataOut7Reg;
ARCH|      end
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** Here the Ram write enable is defined                                       **
ARCH|    *******************************************************************************/
ARCH|    assign s_ramWe = s_weReg & (
ARCH|                     (s_lineEnable0Reg & s_tickDelayReg[1])|
ARCH|                     (s_lineEnable1Reg & s_tickDelayReg[2])|
ARCH|                     (s_lineEnable2Reg & s_tickDelayReg[3])|
ARCH|                     (s_lineEnable3Reg & s_tickDelayReg[4])|
ARCH|                     (s_lineEnable4Reg & s_tickDelayReg[5])|
ARCH|                     (s_lineEnable5Reg & s_tickDelayReg[6])|
ARCH|                     (s_lineEnable6Reg & s_tickDelayReg[7])|
ARCH|                     (s_lineEnable7Reg & s_tickDelayReg[8]));
ARCH| 
ARCH| endmodule
