ARCH|      IF (rising_edge(clock)) THEN
ARCH|        IF (s_tickDelayReg(0) = '1') THEN
ARCH|          s_readAddressReg <= address;
ARCH|        END IF;
ARCH|        IF (tick = '1') THEN
ARCH|          s_writeAddressReg <= address;
ARCH|          s_weReg           <= we;
ARCH|          s_dataIn0Reg <= data0In;
ARCH|          s_lineEnable0Reg <= lineEnable0In;
ARCH|          s_dataIn1Reg <= data1In;
ARCH|          s_lineEnable1Reg <= lineEnable1In;
ARCH|          s_dataIn2Reg <= data2In;
ARCH|          s_lineEnable2Reg <= lineEnable2In;
ARCH|          s_dataIn3Reg <= data3In;
ARCH|          s_lineEnable3Reg <= lineEnable3In;
ARCH|          s_dataIn4Reg <= data4In;
ARCH|          s_lineEnable4Reg <= lineEnable4In;
ARCH|          s_dataIn5Reg <= data5In;
ARCH|          s_lineEnable5Reg <= lineEnable5In;
ARCH|          s_dataIn6Reg <= data6In;
ARCH|          s_lineEnable6Reg <= lineEnable6In;
ARCH|          s_dataIn7Reg <= data7In;
ARCH|          s_lineEnable7Reg <= lineEnable7In;
ARCH|        END IF;
ARCH|      END IF;
ARCH|    END PROCESS inputRegs;
ARCH| 
ARCH|    --------------------------------------------------------------------------------
ARCH|    -- The FSM's are defined here                                                 --
ARCH|    --------------------------------------------------------------------------------
ARCH|    fsms : PROCESS(clock) IS
ARCH|    BEGIN
ARCH|       IF (rising_edge(clock)) THEN
ARCH|          s_tickDelayReg(0)  <= tick;
ARCH|          s_tickDelayReg(8 DOWNTO 1) <= s_tickDelayReg(7 DOWNTO 0);
ARCH|          IF (s_tickDelayReg(0) = '1') THEN
ARCH|            s_addressOffsetReg <= (OTHERS => '0');
ARCH|          ELSIF (unsigned(s_addressOffsetReg) < to_unsigned(8,5)) THEN
ARCH|           s_addressOffsetReg <= std_logic_vector(unsigned(s_addressOffsetReg) + to_unsigned(1,5));
ARCH|          END IF;
ARCH|       END IF;
ARCH|    END PROCESS fsms;
ARCH| 
ARCH|    --------------------------------------------------------------------------------
ARCH|    -- Here the RamDatIn is defined                                               --
ARCH|    --------------------------------------------------------------------------------
ARCH|    WITH (s_addressOffsetReg) SELECT s_ramDataIn <=
ARCH|      s_dataIn7Reg WHEN "00111",
ARCH|      s_dataIn6Reg WHEN "00110",
ARCH|      s_dataIn5Reg WHEN "00101",
ARCH|      s_dataIn4Reg WHEN "00100",
ARCH|      s_dataIn3Reg WHEN "00011",
ARCH|      s_dataIn2Reg WHEN "00010",
ARCH|      s_dataIn1Reg WHEN "00001",
ARCH|                   s_dataIn0Reg WHEN OTHERS;
ARCH| 
ARCH|    --------------------------------------------------------------------------------
ARCH|    -- Here the RamDataOut is defined                                             --
ARCH|    --------------------------------------------------------------------------------
ARCH|    data0Out <= s_dataOut0Reg;
ARCH|    data1Out <= s_dataOut1Reg;
ARCH|    data2Out <= s_dataOut2Reg;
ARCH|    data3Out <= s_dataOut3Reg;
ARCH|    data4Out <= s_dataOut4Reg;
ARCH|    data5Out <= s_dataOut5Reg;
ARCH|    data6Out <= s_dataOut6Reg;
ARCH|    data7Out <= s_dataOut7Reg;
ARCH| 
ARCH|    dataOutRegs : PROCESS (clock) IS
ARCH|    BEGIN
ARCH|      IF (rising_edge(clock)) THEN
ARCH|        IF (s_tickDelayReg(1) = '1') THEN
ARCH|          s_dataOut0Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|        IF (s_tickDelayReg(2) = '1') THEN
ARCH|          s_dataOut1Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|        IF (s_tickDelayReg(3) = '1') THEN
ARCH|          s_dataOut2Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|        IF (s_tickDelayReg(4) = '1') THEN
ARCH|          s_dataOut3Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|        IF (s_tickDelayReg(5) = '1') THEN
ARCH|          s_dataOut4Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|        IF (s_tickDelayReg(6) = '1') THEN
ARCH|          s_dataOut5Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|        IF (s_tickDelayReg(7) = '1') THEN
ARCH|          s_dataOut6Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|        IF (s_tickDelayReg(8) = '1') THEN
ARCH|          s_dataOut7Reg <= s_ramDataOut;
ARCH|        END IF;
ARCH|      END IF;
ARCH|    END PROCESS dataOutRegs;
ARCH| 
ARCH|    --------------------------------------------------------------------------------
ARCH|    -- Here the Ram write enable is defined                                       --
ARCH|    --------------------------------------------------------------------------------
ARCH|    s_ramWe <= s_weReg AND (
ARCH|              (s_lineEnable0Reg AND s_tickDelayReg(1)) OR
ARCH|              (s_lineEnable1Reg AND s_tickDelayReg(2)) OR
ARCH|              (s_lineEnable2Reg AND s_tickDelayReg(3)) OR
ARCH|              (s_lineEnable3Reg AND s_tickDelayReg(4)) OR
ARCH|              (s_lineEnable4Reg AND s_tickDelayReg(5)) OR
ARCH|              (s_lineEnable5Reg AND s_tickDelayReg(6)) OR
