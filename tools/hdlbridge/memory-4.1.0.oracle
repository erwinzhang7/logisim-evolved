ARCH|    reg [7:0] s_dataIn1Reg;
ARCH|    reg [7:0] s_dataIn2Reg;
ARCH|    reg [7:0] s_dataIn3Reg;
ARCH|    reg [7:0] s_dataIn4Reg;
ARCH|    reg [7:0] s_dataIn5Reg;
