ENTITY 26
ENTITY| --==============================================================================
ENTITY| --== Logisim-evolution goes FPGA automatic generated VHDL code                ==
ENTITY| --== https://github.com/logisim-evolution/                                    ==
ENTITY| --==                                                                          ==
ENTITY| --==                                                                          ==
ENTITY| --== Project   : _control_base                                                ==
ENTITY| --== Component : LogisimCounter                                               ==
ENTITY| --==                                                                          ==
ENTITY| --==============================================================================
ENTITY| 
ENTITY| \nLIBRARY ieee;\nUSE ieee.std_logic_1164.all;\nUSE ieee.numeric_std.all;\n\n
ENTITY| ENTITY LogisimCounter IS
ENTITY|    GENERIC ( invertClock : INTEGER;
ENTITY|              maxVal      : std_logic_vector;
ENTITY|              mode        : INTEGER;
ENTITY|              width       : INTEGER );
ENTITY|    PORT ( clear      : IN  std_logic;
ENTITY|           clock      : IN  std_logic;
ENTITY|           enable     : IN  std_logic;
ENTITY|           load       : IN  std_logic;
ENTITY|           loadData   : IN  std_logic_vector( (width - 1) DOWNTO 0 );
ENTITY|           tick       : IN  std_logic;
ENTITY|           upNotDown  : IN  std_logic;
ENTITY|           compareOut : OUT std_logic;
ENTITY|           countValue : OUT std_logic_vector( (width - 1) DOWNTO 0 ) );
ENTITY| END ENTITY LogisimCounter;
ARCH 102
ARCH| --==============================================================================
ARCH| --== Logisim-evolution goes FPGA automatic generated VHDL code                ==
ARCH| --== https://github.com/logisim-evolution/                                    ==
ARCH| --==                                                                          ==
ARCH| --==                                                                          ==
ARCH| --== Project   : _control_base                                                ==
ARCH| --== Component : LogisimCounter                                               ==
ARCH| --==                                                                          ==
ARCH| --==============================================================================
ARCH| 
ARCH| ARCHITECTURE platformIndependent OF LogisimCounter IS 
ARCH| 
ARCH| --------------------------------------------------------------------------------
ARCH| -- All used signals are defined here                                          --
ARCH| --------------------------------------------------------------------------------
ARCH|    SIGNAL s_carry            : std_logic;
ARCH|    SIGNAL s_clock            : std_logic;
ARCH|    SIGNAL s_counterValue     : std_logic_vector( (width - 1) DOWNTO 0 );
ARCH|    SIGNAL s_nextCounterValue : std_logic_vector( (width - 1) DOWNTO 0 );
ARCH|    SIGNAL s_realEnable       : std_logic;
ARCH| 
ARCH| BEGIN
ARCH| 
ARCH|    --------------------------------------------------------------------------------
ARCH|    -- Functionality of the counter:                                              --
ARCH|    --   Load Count | mode                                                        --
ARCH|    --                                                                            --
ARCH|    -- -----------+-------------------                                            --
ARCH|    --     0    0   | halt                                                        --
ARCH|    --     0    1   | count                                                       --
ARCH|    -- up (default)                                                               --
ARCH|    --     1    0   | load                                                        --
ARCH|    --     1    1   | count down                                                  --
ARCH|    --------------------------------------------------------------------------------
ARCH| 
ARCH|    compareOut   <= s_carry;
ARCH|    countValue   <= s_counterValue;
ARCH| 
ARCH|    s_clock      <= clock WHEN invertClock = 0 ELSE NOT(clock);
ARCH| 
ARCH|    makeCarry : PROCESS(upNotDown, s_counterValue) IS
ARCH|    BEGIN
ARCH|       IF (upNotDown = '0') THEN
ARCH|          IF (s_counterValue = std_logic_vector(to_unsigned(0,width))) THEN
ARCH|             s_carry <= '1';
ARCH|          ELSE
ARCH|             s_carry <= '0';
ARCH|          END IF; -- Down counting
ARCH|       ELSE
ARCH|          IF (s_counterValue = maxVal) THEN
ARCH|             s_carry <= '1';
ARCH|          ELSE
ARCH|             s_carry <= '0';
ARCH|          END IF; -- Up counting
ARCH|       END IF;
ARCH|    END PROCESS makeCarry;
ARCH| 
ARCH|    s_realEnable <= '0' WHEN (load = '0' AND enable = '0') -- Counter disabled
ARCH|                           OR (mode = 1 AND s_carry = '1' AND load = '0') -- Stay at value situation
ARCH|                         ELSE tick;
ARCH| 
ARCH|    makeNextValue : PROCESS(load ,upNotDown ,s_counterValue ,loadData , s_carry) IS
ARCH|       VARIABLE v_downcount : std_logic;
ARCH|    BEGIN
ARCH|       v_downcount := NOT(upNotDown);
ARCH|       IF ((load = '1') OR -- load condition
ARCH|           (mode = 3 AND s_carry = '1')    -- Wrap load condition
ARCH|          ) THEN s_nextCounterValue <= loadData;
ARCH|       ELSE
ARCH|          CASE (mode) IS
ARCH|             WHEN  0    => IF (s_carry = '1') THEN
ARCH|                              IF (v_downcount = '1') THEN
ARCH|                                 s_nextCounterValue <= maxVal;
ARCH|                              ELSE
ARCH|                                 s_nextCounterValue <= (OTHERS => '0');
ARCH|                              END IF;
ARCH|                           ELSE
ARCH|                              IF (v_downcount = '1') THEN
ARCH|                                 s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) - 1);
ARCH|                              ELSE
ARCH|                                 s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) + 1);
ARCH|                              END IF;
ARCH|                           END IF;
ARCH|            WHEN OTHERS => IF (v_downcount = '1') THEN
ARCH|                               s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) - 1);
ARCH|                           ELSE
ARCH|                               s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) + 1);
ARCH|                           END IF;
ARCH|          END CASE;
ARCH|       END IF;
ARCH|    END PROCESS makeNextValue;
ARCH| 
ARCH|    makeFlops : PROCESS(s_clock, s_realEnable, clear, s_nextCounterValue ) IS
ARCH|    BEGIN
ARCH|       IF (clear = '1') THEN s_counterValue <= (OTHERS => '0');
ARCH|       ELSIF (rising_edge(s_clock)) THEN
ARCH|          IF (s_realEnable = '1') THEN s_counterValue <= s_nextCounterValue;
ARCH|          END IF;
ARCH|       END IF;
ARCH|    END PROCESS makeFlops;
ARCH| 
ARCH| END platformIndependent;
