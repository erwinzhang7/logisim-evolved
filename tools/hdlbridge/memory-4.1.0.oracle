ARCH|    *******************************************************************************/
ARCH|    assign s_ramWriteAddress = s_writeAddressReg + s_addressOffsetReg[3:0];
ARCH|    assign s_ramReadAddress = s_readAddressReg + s_addressOffsetReg[3:0];
