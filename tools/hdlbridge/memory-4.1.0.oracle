ARCH|    -- The synchronous semi-dual-ported memory is defined here                    --
ARCH|    --------------------------------------------------------------------------------
ARCH|    s_ramWriteAddress <= std_logic_vector(unsigned(s_writeAddressReg) + unsigned(s_addressOffsetReg(3 DOWNTO 0)));
ARCH|    s_ramReadAddress <= std_logic_vector(unsigned(s_readAddressReg) + unsigned(s_addressOffsetReg(3 DOWNTO 0)));
ARCH| 
ARCH|    blockramwrite : PROCESS(clock) IS
ARCH|    BEGIN
ARCH|      IF (rising_edge(clock)) THEN
ARCH|        IF (s_ramWe = '1') THEN
ARCH|          s_memContents(to_integer(unsigned(s_ramWriteAddress))) <= s_ramDataIn;
ARCH|        END IF;
ARCH|      END IF;
ARCH|    END PROCESS blockramwrite;
ARCH| 
ARCH|    blockramread : PROCESS(clock) IS
ARCH|    BEGIN
ARCH|      IF (falling_edge(clock)) THEN
ARCH|        s_ramDataOut <= s_memContents(to_integer(unsigned(s_ramReadAddress)));
ARCH|      END IF;
ARCH|    END PROCESS blockramread;
