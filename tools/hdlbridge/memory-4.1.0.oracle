ARCH| 
ARCH|    compareOut   <= s_carry;
ARCH|    countValue   <= s_counterValue;
ARCH| 
ARCH|    s_clock      <= clock WHEN invertClock = 0 ELSE NOT(clock);
ARCH| 
ARCH|    makeCarry : PROCESS(upNotDown, s_counterValue) IS
ARCH|    BEGIN
ARCH|       IF (upNotDown = '0') THEN
ARCH|          IF (s_counterValue = std_logic_vector(to_unsigned(0,width))) THEN
ARCH|             s_carry <= '1';
ARCH|          ELSE
ARCH|             s_carry <= '0';
ARCH|          END IF; -- Down counting
ARCH|       ELSE
ARCH|          IF (s_counterValue = maxVal) THEN
ARCH|             s_carry <= '1';
ARCH|          ELSE
ARCH|             s_carry <= '0';
ARCH|          END IF; -- Up counting
ARCH|       END IF;
ARCH|    END PROCESS makeCarry;
ARCH| 
ARCH|    s_realEnable <= '0' WHEN (load = '0' AND enable = '0') -- Counter disabled
ARCH|                           OR (mode = 1 AND s_carry = '1' AND load = '0') -- Stay at value situation
ARCH|                         ELSE tick;
ARCH| 
ARCH|    makeNextValue : PROCESS(load ,upNotDown ,s_counterValue ,loadData , s_carry) IS
ARCH|       VARIABLE v_downcount : std_logic;
ARCH|    BEGIN
ARCH|       v_downcount := NOT(upNotDown);
ARCH|       IF ((load = '1') OR -- load condition
ARCH|           (mode = 3 AND s_carry = '1')    -- Wrap load condition
ARCH|          ) THEN s_nextCounterValue <= loadData;
ARCH|       ELSE
ARCH|          CASE (mode) IS
ARCH|             WHEN  0    => IF (s_carry = '1') THEN
ARCH|                              IF (v_downcount = '1') THEN
ARCH|                                 s_nextCounterValue <= maxVal;
ARCH|                              ELSE
ARCH|                                 s_nextCounterValue <= (OTHERS => '0');
ARCH|                              END IF;
ARCH|                           ELSE
ARCH|                              IF (v_downcount = '1') THEN
ARCH|                                 s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) - 1);
ARCH|                              ELSE
ARCH|                                 s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) + 1);
ARCH|                              END IF;
ARCH|                           END IF;
ARCH|            WHEN OTHERS => IF (v_downcount = '1') THEN
ARCH|                               s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) - 1);
ARCH|                           ELSE
ARCH|                               s_nextCounterValue <= std_logic_vector(unsigned(s_counterValue) + 1);
ARCH|                           END IF;
ARCH|          END CASE;
ARCH|       END IF;
ARCH|    END PROCESS makeNextValue;
ARCH| 
ARCH|    makeFlops : PROCESS(s_clock, s_realEnable, clear, s_nextCounterValue ) IS
ARCH|    BEGIN
ARCH|       IF (clear = '1') THEN s_counterValue <= (OTHERS => '0');
ARCH|       ELSIF (rising_edge(s_clock)) THEN
ARCH|          IF (s_realEnable = '1') THEN s_counterValue <= s_nextCounterValue;
ARCH|          END IF;
ARCH|       END IF;
ARCH|    END PROCESS makeFlops;
ARCH| 
ARCH| END platformIndependent;
