ARCH|    SIGNAL s_lineEnable2Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable3Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable4Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable5Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable6Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable7Reg   : std_logic;
