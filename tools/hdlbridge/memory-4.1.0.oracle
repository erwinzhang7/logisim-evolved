ARCH|        5'd6    : s_ramDataIn <= s_dataIn6Reg;
ARCH|        5'd5    : s_ramDataIn <= s_dataIn5Reg;
ARCH|        5'd4    : s_ramDataIn <= s_dataIn4Reg;
ARCH|        5'd3    : s_ramDataIn <= s_dataIn3Reg;
ARCH|        5'd2    : s_ramDataIn <= s_dataIn2Reg;
