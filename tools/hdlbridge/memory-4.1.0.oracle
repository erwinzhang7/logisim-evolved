ARCH|    SIGNAL s_dataIn7Reg       : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut0Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut1Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut2Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut3Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut4Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut5Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut6Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_dataOut7Reg      : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_lineEnable0Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable1Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable2Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable3Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable4Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable5Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable6Reg   : std_logic;
ARCH|    SIGNAL s_lineEnable7Reg   : std_logic;
ARCH|    SIGNAL s_memContents      : memoryArray;
ARCH|    SIGNAL s_ramDataIn        : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_ramDataOut       : std_logic_vector( 31 DOWNTO 0 );
ARCH|    SIGNAL s_ramReadAddress   : std_logic_vector( 3 DOWNTO 0 );
ARCH|    SIGNAL s_ramWe            : std_logic;
ARCH|    SIGNAL s_ramWriteAddress  : std_logic_vector( 3 DOWNTO 0 );
ARCH|    SIGNAL s_readAddressReg   : std_logic_vector( 3 DOWNTO 0 );
