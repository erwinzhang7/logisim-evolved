ARCH|    SIGNAL s_carry            : std_logic;
ARCH|    SIGNAL s_clock            : std_logic;
ARCH|    SIGNAL s_counterValue     : std_logic_vector( (width - 1) DOWNTO 0 );
ARCH|    SIGNAL s_nextCounterValue : std_logic_vector( (width - 1) DOWNTO 0 );
ARCH|    SIGNAL s_realEnable       : std_logic;
