ARCH|    assign data1Out = s_dataOut1Reg;
ARCH|    assign data2Out = s_dataOut2Reg;
ARCH|    assign data3Out = s_dataOut3Reg;
ARCH|    assign data4Out = s_dataOut4Reg;
