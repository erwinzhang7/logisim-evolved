ARCH|             lineEnable3In,
ARCH|             lineEnable4In,
ARCH|             lineEnable5In,
ARCH|             lineEnable6In,
ARCH|             lineEnable7In,
ARCH|             tick,
ARCH|             we );
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** Here all private types are defined                                         **
ARCH|    *******************************************************************************/
ARCH|       typedef logic [31:0] memoryArray [256:0];
ARCH| 
ARCH|    /*******************************************************************************
ARCH|    ** The inputs are defined here                                                **
ARCH|    *******************************************************************************/
ARCH|    input [7:0]  address;
ARCH|    input        clock;
ARCH|    input [31:0] data0In;
