ARCH|    s_clock      <= clock WHEN invertClock = 0 ELSE NOT(clock);
ARCH| 
ARCH|    makeCarry : PROCESS(upNotDown, s_counterValue) IS
ARCH|    BEGIN
ARCH|       IF (upNotDown = '0') THEN
ARCH|          IF (s_counterValue = std_logic_vector(to_unsigned(0,width))) THEN
ARCH|             s_carry <= '1';
ARCH|          ELSE
ARCH|             s_carry <= '0';
ARCH|          END IF; -- Down counting
ARCH|       ELSE
ARCH|          IF (s_counterValue = maxVal) THEN
ARCH|             s_carry <= '1';
ARCH|          ELSE
ARCH|             s_carry <= '0';
ARCH|          END IF; -- Up counting
ARCH|       END IF;
ARCH|    END PROCESS makeCarry;
ARCH| 
ARCH|    s_realEnable <= '0' WHEN (load = '0' AND enable = '0') -- Counter disabled
ARCH|                           OR (mode = 1 AND s_carry = '1' AND load = '0') -- Stay at value situation
ARCH|                         ELSE tick;
ARCH| 
ARCH|    makeNextValue : PROCESS(load ,upNotDown ,s_counterValue ,loadData , s_carry) IS
ARCH|       VARIABLE v_downcount : std_logic;
ARCH|    BEGIN
ARCH|       v_downcount := NOT(upNotDown);
ARCH|       IF ((load = '1') OR -- load condition
