INST|              load       : IN  std_logic;
INST|              loadData   : IN  std_logic_vector( (width - 1) DOWNTO 0 );
INST|              tick       : IN  std_logic;
INST|              upNotDown  : IN  std_logic;
INST|              compareOut : OUT std_logic;
INST|              countValue : OUT std_logic_vector( (width - 1) DOWNTO 0 ) );
INST|    END COMPONENT;
PORTS 8
