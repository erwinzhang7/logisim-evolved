ARCH|          s_dataIn0Reg <= data0In;
ARCH|          s_lineEnable0Reg <= lineEnable0In;
ARCH|          s_dataIn1Reg <= data1In;
ARCH|          s_lineEnable1Reg <= lineEnable1In;
ARCH|          s_dataIn2Reg <= data2In;
