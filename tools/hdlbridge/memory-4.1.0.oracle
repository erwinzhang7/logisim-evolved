ARCH|        s_dataOut1Reg <= (s_tickDelayReg[2] == 1'b1) ? s_ramDataOut : s_dataOut1Reg;
ARCH|        s_dataOut2Reg <= (s_tickDelayReg[3] == 1'b1) ? s_ramDataOut : s_dataOut2Reg;
ARCH|        s_dataOut3Reg <= (s_tickDelayReg[4] == 1'b1) ? s_ramDataOut : s_dataOut3Reg;
ARCH|        s_dataOut4Reg <= (s_tickDelayReg[5] == 1'b1) ? s_ramDataOut : s_dataOut4Reg;
ARCH|        s_dataOut5Reg <= (s_tickDelayReg[6] == 1'b1) ? s_ramDataOut : s_dataOut5Reg;
ARCH|        s_dataOut6Reg <= (s_tickDelayReg[7] == 1'b1) ? s_ramDataOut : s_dataOut6Reg;
ARCH|        s_dataOut7Reg <= (s_tickDelayReg[8] == 1'b1) ? s_ramDataOut : s_dataOut7Reg;
ARCH|      end
