ARCH|    /*******************************************************************************
ARCH|    ** Here the Ram write enable is defined                                       **
ARCH|    *******************************************************************************/
ARCH|    assign s_ramWe = s_weReg & (
ARCH|                     (s_lineEnable0Reg & s_tickDelayReg[1])|
ARCH|                     (s_lineEnable1Reg & s_tickDelayReg[2])|
ARCH|                     (s_lineEnable2Reg & s_tickDelayReg[3])|
ARCH|                     (s_lineEnable3Reg & s_tickDelayReg[4])|
ARCH|                     (s_lineEnable4Reg & s_tickDelayReg[5])|
ARCH|                     (s_lineEnable5Reg & s_tickDelayReg[6])|
ARCH|                     (s_lineEnable6Reg & s_tickDelayReg[7])|
ARCH|                     (s_lineEnable7Reg & s_tickDelayReg[8]));
