INST|    COMPONENT LogisimCounter
INST|       GENERIC ( invertClock : INTEGER;
INST|                 maxVal      : std_logic_vector;
INST|                 mode        : INTEGER;
INST|                 width       : INTEGER );
INST|       PORT ( clear      : IN  std_logic;
