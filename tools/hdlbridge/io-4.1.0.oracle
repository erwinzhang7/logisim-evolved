     ** Here all module parameters are defined with a dummy value                  **
     *******************************************************************************/
     parameter activeLow = 1;
     parameter nrOfControl = 1;
     parameter nrOfDigits = 1;
     parameter nrOfScanningCounterBits = 1;
     parameter nrOfSegments = 1;
     parameter scanningCounterReloadValue = 1;
  
     /*******************************************************************************
     ** The inputs are defined here                                                **
     *******************************************************************************/
     input [nrOfSegments-1:0] allSegments;
     input                    fpgaGlobalClock;
  
     /*******************************************************************************
     ** The outputs are defined here                                               **
     *******************************************************************************/
     output                   DecimalPoint;
     output                   Segment_A;
     output                   Segment_B;
     output                   Segment_C;
     output                   Segment_D;
     output                   Segment_E;
     output                   Segment_F;
     output                   Segment_G;
     output [nrOfControl-1:0] digitDecodedSelect;
  
     /*******************************************************************************
     ** The wires are defined here                                                 **
     *******************************************************************************/
     wire [nrOfControl-1:0]             s_columnCounterNext;
     wire [nrOfScanningCounterBits-1:0] s_scanningCounterNext;
     wire                               s_tickNext;
  
     /*******************************************************************************
     ** The registers are defined here                                             **
     *******************************************************************************/
     reg [nrOfControl-1:0]             s_columnCounterReg;
     reg [nrOfScanningCounterBits-1:0] s_scanningCounterReg;
     reg                               s_tickReg;
  
     /*******************************************************************************
     ** The module functionality is described here                                 **
     *******************************************************************************/
  
     assign s_tickNext = (s_scanningCounterReg == 0) ? 1'b1 : 1'b0;
     assign s_scanningCounterNext = (s_scanningCounterReg == 0) ? scanningCounterReloadValue : s_scanningCounterReg - 1;
     assign s_columnCounterNext =  (s_tickReg == 1'b0) ? s_columnCounterReg : (s_columnCounterReg == 0) ? nrOfDigits - 1 : s_columnCounterReg - 1;
  
     assign Segment_A = allSegments[s_columnCounterReg * 8 + 0] ^ activeLow;
     assign Segment_B = allSegments[s_columnCounterReg * 8 + 1] ^ activeLow;
     assign Segment_C = allSegments[s_columnCounterReg * 8 + 2] ^ activeLow;
     assign Segment_D = allSegments[s_columnCounterReg * 8 + 3] ^ activeLow;
     assign Segment_E = allSegments[s_columnCounterReg * 8 + 4] ^ activeLow;
     assign Segment_F = allSegments[s_columnCounterReg * 8 + 5] ^ activeLow;
     assign Segment_G = allSegments[s_columnCounterReg * 8 + 6] ^ activeLow;
     assign DecimalPoint = allSegments[s_columnCounterReg * 8 + 7] ^ activeLow;
     /*******************************************************************************
     ** Here the simulation only initial is defined                                **
     *******************************************************************************/
     initial
     begin
        s_scanningCounterReg = 0;
        s_columnCounterReg   = 0;
        s_tickReg            = 1'b0;
     end
  
     always @(posedge fpgaGlobalClock)
     begin
         s_scanningCounterReg = s_scanningCounterNext;
         s_columnCounterReg   = s_columnCounterNext;
         s_tickReg            = s_tickNext;
     end
  
     assign digitDecodedSelect = s_columnCounterReg;
  
