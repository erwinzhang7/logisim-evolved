     *******************************************************************************/
     parameter activeLow = 1;
     parameter maxNrLedsAddrColumns = 1;
     parameter nrOfColumnAddressBits = 1;
     parameter nrOfColumns = 1;
     parameter nrOfLeds = 1;
     parameter nrOfRows = 1;
     parameter nrOfScanningCounterBits = 1;
     parameter scanningCounterReloadValue = 1;
  
     /*******************************************************************************
     ** The inputs are defined here                                                **
     *******************************************************************************/
     input                fpgaGlobalClock;
     input [nrOfLeds-1:0] internalBlueLeds;
     input [nrOfLeds-1:0] internalGreenLeds;
     input [nrOfLeds-1:0] internalRedLeds;
  
     /*******************************************************************************
