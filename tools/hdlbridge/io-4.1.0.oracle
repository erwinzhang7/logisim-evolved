                                 fpgaGlobalClock,
                                 internalBlueLeds,
                                 internalGreenLeds,
                                 internalRedLeds,
                                 rowBlueLeds,
                                 rowGreenLeds,
                                 rowRedLeds );
  
     /*******************************************************************************
