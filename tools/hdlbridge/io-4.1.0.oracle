     *******************************************************************************/
     output [nrOfColumnAddressBits-1:0] columnAddress;
     output [nrOfRows-1:0]              rowBlueLeds;
     output [nrOfRows-1:0]              rowGreenLeds;
     output [nrOfRows-1:0]              rowRedLeds;
  
     /*******************************************************************************
     ** The wires are defined here                                                 **
     *******************************************************************************/
     wire [nrOfColumnAddressBits-1:0]   s_columnCounterNext;
     wire [maxNrLedsAddrColumns-1:0]    s_maxBlueLedInputs;
     wire [maxNrLedsAddrColumns-1:0]    s_maxGreenLedInputs;
     wire [maxNrLedsAddrColumns-1:0]    s_maxLedInputs;
     wire [maxNrLedsAddrColumns-1:0]    s_maxRedLedInputs;
     wire [nrOfScanningCounterBits-1:0] s_scanningCounterNext;
