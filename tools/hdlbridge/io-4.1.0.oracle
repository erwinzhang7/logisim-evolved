           s_maxBlueLedInputs(nrOfLeds-1 DOWNTO 0)  <= internalBlueLeds;
        END IF;
     END PROCESS makeVirtualInputs;
  
     genOutputs : FOR n IN nrOfRows-1 DOWNTO 0 GENERATE
        rowRedLeds(n) <= s_maxRedLedInputs(to_integer(unsigned(s_columnCounterReg)) + n*nrOfColumns);
        rowGreenLeds(n) <= s_maxGreenLedInputs(to_integer(unsigned(s_columnCounterReg)) + n*nrOfColumns);
        rowBlueLeds(n) <= s_maxBlueLedInputs(to_integer(unsigned(s_columnCounterReg)) + n*nrOfColumns);
     END GENERATE genOutputs;
  
