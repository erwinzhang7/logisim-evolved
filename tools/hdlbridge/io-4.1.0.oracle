                                      Segment_A,
                                      Segment_B,
                                      Segment_C,
                                      Segment_D,
                                      Segment_E,
                                      Segment_F,
                                      Segment_G,
                                      allSegments,
                                      digitDecodedSelect,
                                      fpgaGlobalClock );
  
