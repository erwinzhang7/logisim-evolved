CASE	Button/press=active	VHDL
  s_logisimNet0 <= logisimInputBubbles(4);
ENDCASE
CASE	Button/press=passive	VHDL
  s_logisimNet0 <=  NOT logisimInputBubbles(4);
ENDCASE
CASE	Button/unconnected	VHDL
ENDCASE
CASE	DipSwitch/size=2	VHDL
  s_logisimNet0 <= logisimInputBubbles(3);
  s_logisimNet1 <= logisimInputBubbles(4);
ENDCASE
CASE	DipSwitch/size=4	VHDL
  s_logisimNet0 <= logisimInputBubbles(3);
  s_logisimNet1 <= logisimInputBubbles(4);
  s_logisimNet2 <= logisimInputBubbles(5);
  s_logisimNet3 <= logisimInputBubbles(6);
ENDCASE
CASE	DipSwitch/size=8	VHDL
  s_logisimNet0 <= logisimInputBubbles(3);
  s_logisimNet1 <= logisimInputBubbles(4);
  s_logisimNet2 <= logisimInputBubbles(5);
  s_logisimNet3 <= logisimInputBubbles(6);
  s_logisimNet4 <= logisimInputBubbles(7);
  s_logisimNet5 <= logisimInputBubbles(8);
  s_logisimNet6 <= logisimInputBubbles(9);
  s_logisimNet7 <= logisimInputBubbles(10);
ENDCASE
CASE	Led	VHDL
  logisimOutputBubbles(7) <= s_logisimNet0;
ENDCASE
CASE	Led/unconnected	VHDL
  logisimOutputBubbles(7) <= '0';
ENDCASE
CASE	RgbLed	VHDL
  logisimOutputBubbles(11) <= s_logisimNet0;
  logisimOutputBubbles(12) <= s_logisimNet1;
  logisimOutputBubbles(13) <= s_logisimNet2;
ENDCASE
CASE	SevenSegment/dp=false	VHDL
  logisimOutputBubbles(2) <= s_logisimNet0;
  logisimOutputBubbles(3) <= s_logisimNet1;
  logisimOutputBubbles(4) <= s_logisimNet2;
  logisimOutputBubbles(5) <= s_logisimNet3;
  logisimOutputBubbles(6) <= s_logisimNet4;
  logisimOutputBubbles(7) <= s_logisimNet5;
  logisimOutputBubbles(8) <= s_logisimNet6;
ENDCASE
CASE	SevenSegment/dp=true	VHDL
  logisimOutputBubbles(2) <= s_logisimNet0;
  logisimOutputBubbles(3) <= s_logisimNet1;
  logisimOutputBubbles(4) <= s_logisimNet2;
  logisimOutputBubbles(5) <= s_logisimNet3;
  logisimOutputBubbles(6) <= s_logisimNet4;
  logisimOutputBubbles(7) <= s_logisimNet5;
  logisimOutputBubbles(8) <= s_logisimNet6;
  logisimOutputBubbles(9) <= s_logisimNet7;
ENDCASE
CASE	HexDigit/connected=true/dp=false	VHDL
  WITH (s_logisimBus0) SELECT logisimOutputBubbles(22 DOWNTO 16) <=
     "011"&X"F" WHEN X"0",
     "000"&X"6" WHEN X"1",
     "101"&X"B" WHEN X"2",
     "100"&X"F" WHEN X"3",
     "110"&X"6" WHEN X"4",
     "110"&X"D" WHEN X"5",
     "111"&X"D" WHEN X"6",
     "000"&X"7" WHEN X"7",
     "111"&X"F" WHEN X"8",
     "110"&X"7" WHEN X"9",
     "111"&X"7" WHEN X"A",
     "111"&X"C" WHEN X"B",
     "011"&X"9" WHEN X"C",
     "101"&X"E" WHEN X"D",
     "111"&X"9" WHEN X"E",
     "111"&X"1" WHEN OTHERS;
ENDCASE
CASE	HexDigit/connected=true/dp=true	VHDL
  WITH (s_logisimBus0) SELECT logisimOutputBubbles(22 DOWNTO 16) <=
     "011"&X"F" WHEN X"0",
     "000"&X"6" WHEN X"1",
     "101"&X"B" WHEN X"2",
     "100"&X"F" WHEN X"3",
     "110"&X"6" WHEN X"4",
     "110"&X"D" WHEN X"5",
     "111"&X"D" WHEN X"6",
     "000"&X"7" WHEN X"7",
     "111"&X"F" WHEN X"8",
     "110"&X"7" WHEN X"9",
     "111"&X"7" WHEN X"A",
     "111"&X"C" WHEN X"B",
     "011"&X"9" WHEN X"C",
     "101"&X"E" WHEN X"D",
     "111"&X"9" WHEN X"E",
     "111"&X"1" WHEN OTHERS;
  logisimOutputBubbles(23) <= s_logisimNet1;
ENDCASE
CASE	HexDigit/connected=false/dp=false	VHDL
  logisimOutputBubbles(22 DOWNTO 16) <= "000"&X"0";
ENDCASE
CASE	HexDigit/connected=false/dp=true	VHDL
  logisimOutputBubbles(22 DOWNTO 16) <= "000"&X"0";
  logisimOutputBubbles(23) <= '0';
ENDCASE
