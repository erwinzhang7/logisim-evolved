  -- All used signals are defined here                                          --
  --------------------------------------------------------------------------------
     SIGNAL s_columnCounterNext   : std_logic_vector( (nrOfColumnAddressBits - 1) DOWNTO 0 );
     SIGNAL s_columnCounterReg    : std_logic_vector( (nrOfColumnAddressBits - 1) DOWNTO 0 );
     SIGNAL s_maxBlueLedInputs    : std_logic_vector( (maxNrLedsAddrColumns - 1) DOWNTO 0 );
     SIGNAL s_maxGreenLedInputs   : std_logic_vector( (maxNrLedsAddrColumns - 1) DOWNTO 0 );
     SIGNAL s_maxLedInputs        : std_logic_vector( (maxNrLedsAddrColumns - 1) DOWNTO 0 );
     SIGNAL s_maxRedLedInputs     : std_logic_vector( (maxNrLedsAddrColumns - 1) DOWNTO 0 );
     SIGNAL s_scanningCounterNext : std_logic_vector( (nrOfScanningCounterBits - 1) DOWNTO 0 );
     SIGNAL s_scanningCounterReg  : std_logic_vector( (nrOfScanningCounterBits - 1) DOWNTO 0 );
     SIGNAL s_tickNext            : std_logic;
     SIGNAL s_tickReg             : std_logic;
  
  BEGIN
  
     columnAddress <= s_columnCounterReg;
  
     s_tickNext <= '1' WHEN s_scanningCounterReg = std_logic_vector(to_unsigned(0, nrOfScanningCounterBits)) ELSE '0';
  
     s_scanningCounterNext <= (OTHERS => '0') WHEN s_tickReg /= '0' AND s_tickReg /= '1' ELSE -- for simulation
                              std_logic_vector(to_unsigned(scanningCounterReloadValue-1, nrOfScanningCounterBits))
                                 WHEN s_scanningCounterReg = std_logic_vector(to_unsigned(0, nrOfScanningCounterBits)) ELSE
                              std_logic_vector(unsigned(s_scanningCounterReg)-1);
  
     s_columnCounterNext <= (OTHERS => '0') WHEN s_tickReg /= '0' AND s_tickReg /= '1' ELSE -- for simulation
                            s_columnCounterReg WHEN s_tickReg = '0' ELSE
                            std_logic_vector(to_unsigned(nrOfColumns-1,nrOfcolumnAddressBits))
                               WHEN s_columnCounterReg = std_logic_vector(to_unsigned(0,nrOfColumnAddressBits)) ELSE
                            std_logic_vector(unsigned(s_columnCounterReg)-1);
  
     makeFlops : PROCESS (fpgaGlobalClock) IS
     BEGIN
        IF (rising_edge(fpgaGlobalClock)) THEN
           s_columnCounterReg   <= s_columnCounterNext;
           s_scanningCounterReg <= s_scanningCounterNext;
           s_tickReg            <= s_tickNext;
        END IF;
     END PROCESS makeFlops;
  
     makeVirtualInputs : PROCESS ( internalRedLeds, internalGreenLeds, internalBlueLeds ) IS
     BEGIN
        s_maxRedLedInputs <= (OTHERS => '0');
        s_maxGreenLedInputs <= (OTHERS => '0');
        s_maxBlueLedInputs <= (OTHERS => '0');
        IF (activeLow = 1) THEN
           s_maxRedLedInputs(nrOfLeds-1 DOWNTO 0)   <= NOT internalRedLeds;
           s_maxGreenLedInputs(nrOfLeds-1 DOWNTO 0) <= NOT internalGreenLeds;
           s_maxBlueLedInputs(nrOfLeds-1 DOWNTO 0)  <= NOT internalBlueLeds;
        ELSE
           s_maxRedLedInputs(nrOfLeds-1 DOWNTO 0)   <= internalRedLeds;
