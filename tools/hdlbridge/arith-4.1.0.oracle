ARCH|                              s_stage3Result[32:17] :
ARCH|                              (shifterMode == 3) ?
ARCH|                              { 16{s_stage3Result[32]} } :
ARCH|                              (shifterMode == 4) ?
ARCH|                              s_stage3Result[15:0] : 0;
ARCH|
