LANG Verilog
HDLNAME Subtractor
SYNTH 1
SUPP 1
DIR verilog/arith/
INLINED 0
SUPPORTED 1
GENTIME 0
PARAMKEY -1 name=nrOfBits int=1
PARAMKEY -2 name=extendedBits int=1
PARAM extendedBits = 17
PARAM nrOfBits = 16
PARAMEMPTY 0
PORT dataA bits=-1 pin=0 clock=0 pulldown=1
PORT dataB bits=-1 pin=1 clock=0 pulldown=1
PORT borrowIn bits=1 pin=3 clock=0 pulldown=1
