WIRE s_extendedcarryIn bits=-2
WIRE s_newResult bits=-2
FUNC|
FUNC|s_multResult <= std_logic_vector(unsigned(inputA)*unsigned(inputB))
FUNC|                    WHEN unsignedMultiplier= 1 ELSE
FUNC|                 std_logic_vector(signed(inputA)*signed(inputB));
FUNC|s_extendedcarryIn(calcBits-1 DOWNTO nrOfBits) <= (OTHERS => '0') WHEN unsignedMultiplier = 1 ELSE (OTHERS => carryIn(nrOfBits-1));
FUNC|s_extendedcarryIn(nrOfBits-1 DOWNTO 0) <= carryIn;
FUNC|s_newResult  <= std_logic_vector(unsigned(s_multResult) + unsigned(s_extendedcarryIn))
FUNC|                    WHEN unsignedMultiplier= 1 ELSE
FUNC|                 std_logic_vector(signed(s_multResult) + signed(s_extendedcarryIn));
FUNC|multHigh     <= s_newResult(calcBits-1 DOWNTO nrOfBits);
FUNC|multLow      <= s_newResult(nrOfBits-1 DOWNTO 0);
FUNC|
FUNC|
