FUNC|                   s_stage0ShiftIn&dataA( 15 DOWNTO 1 );
FUNC|
FUNC|
FUNC|--------------------------------------------------------------------------------
FUNC|-- Stage 1 of the binary shift tree is defined here                           --
FUNC|--------------------------------------------------------------------------------
FUNC|s_stage1ShiftIn <= s_stage0Result( 15 DOWNTO 14 ) WHEN shifterMode = 1 ELSE
FUNC|                   (OTHERS => s_stage0Result(0)) WHEN shifterMode = 3 ELSE
FUNC|                   s_stage0Result( 1 DOWNTO 0 ) WHEN shifterMode = 4 ELSE
FUNC|                   (OTHERS => '0');
FUNC|
FUNC|s_stage1Result  <= s_stage0Result
FUNC|                      WHEN shiftAmount(1) = '0' ELSE
FUNC|                   s_stage0Result( 13 DOWNTO 0 )&s_stage1ShiftIn
FUNC|                      WHEN shifterMode = 0 OR shifterMode = 1 ELSE
