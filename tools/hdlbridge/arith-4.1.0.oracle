FUNC|-- 1 : Rotate Left                                                            --
FUNC|-- 2 :                                                                        --
FUNC|-- Logical Shift Right                                                        --
FUNC|-- 3 : Arithmetic Shift Right                                                 --
FUNC|-- 4 : Rotate Right                                                           --
FUNC|--------------------------------------------------------------------------------
FUNC|
