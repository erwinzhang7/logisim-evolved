ARCH|   ** The wires are defined here                                                 **
ARCH|   *******************************************************************************/
ARCH|   wire [30:0] s_stage0Result;
ARCH|   wire        s_stage0ShiftIn;
ARCH|   wire [30:0] s_stage1Result;
ARCH|   wire [1:0]  s_stage1ShiftIn;
ARCH|   wire [30:0] s_stage2Result;
ARCH|   wire [3:0]  s_stage2ShiftIn;
ARCH|   wire [30:0] s_stage3Result;
ARCH|   wire [7:0]  s_stage3ShiftIn;
ARCH|   wire [30:0] s_stage4Result;
ARCH|   wire [15:0] s_stage4ShiftIn;
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** The module functionality is described here                                 **
ARCH|   *******************************************************************************/
ARCH|   /*******************************************************************************
ARCH|   ** ShifterMode represents when:                                               **
ARCH|   ** 0 : Logical Shift Left                                                     **
ARCH|   ** 1 : Rotate Left                                                            **
ARCH|   ** 2 :                                                                        **
ARCH|   ** Logical Shift Right                                                        **
ARCH|   ** 3 : Arithmetic Shift Right                                                 **
ARCH|   ** 4 : Rotate Right                                                           **
ARCH|   *******************************************************************************/
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** Stage 0 of the binary shift tree is defined here                           **
ARCH|   *******************************************************************************/
ARCH|   assign s_stage0ShiftIn = ((shifterMode == 1) || (shifterMode == 3))
ARCH|        ? dataA[shifterMode] : (30 == 4) ? dataA[0] : 0;
ARCH|
ARCH|   assign s_stage0Result  = (shiftAmount == 0)
ARCH|        ? dataA
ARCH|        : ((shifterMode == 0) || (shifterMode == 1))
ARCH|           ? {dataA[29:0],s_stage0ShiftIn}
ARCH|           : {s_stage0ShiftIn,dataA[30:1]};
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** Stage 1 of the binary shift tree is defined here                           **
ARCH|   *******************************************************************************/
ARCH|   assign s_stage1ShiftIn = (shifterMode == 1) ?
ARCH|                              s_stage0Result[30:29] :
ARCH|                              (shifterMode == 3) ?
ARCH|                              { 2{s_stage0Result[30]} } :
ARCH|                              (shifterMode == 4) ?
ARCH|                              s_stage0Result[1:0] : 0;
ARCH|
ARCH|   assign s_stage1Result  = (shiftAmount[1]==0) ?
ARCH|                              s_stage0Result :
ARCH|                              ((shifterMode == 0)||(shifterMode == 1)) ?
ARCH|                              {s_stage0Result[28:0],s_stage1ShiftIn} :
ARCH|                              {s_stage1ShiftIn,s_stage0Result[30:2]};
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** Stage 2 of the binary shift tree is defined here                           **
ARCH|   *******************************************************************************/
ARCH|   assign s_stage2ShiftIn = (shifterMode == 1) ?
ARCH|                              s_stage1Result[30:27] :
ARCH|                              (shifterMode == 3) ?
ARCH|                              { 4{s_stage1Result[30]} } :
ARCH|                              (shifterMode == 4) ?
ARCH|                              s_stage1Result[3:0] : 0;
ARCH|
ARCH|   assign s_stage2Result  = (shiftAmount[2]==0) ?
ARCH|                              s_stage1Result :
ARCH|                              ((shifterMode == 0)||(shifterMode == 1)) ?
ARCH|                              {s_stage1Result[26:0],s_stage2ShiftIn} :
ARCH|                              {s_stage2ShiftIn,s_stage1Result[30:4]};
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** Stage 3 of the binary shift tree is defined here                           **
ARCH|   *******************************************************************************/
ARCH|   assign s_stage3ShiftIn = (shifterMode == 1) ?
ARCH|                              s_stage2Result[30:23] :
ARCH|                              (shifterMode == 3) ?
ARCH|                              { 8{s_stage2Result[30]} } :
ARCH|                              (shifterMode == 4) ?
ARCH|                              s_stage2Result[7:0] : 0;
ARCH|
ARCH|   assign s_stage3Result  = (shiftAmount[3]==0) ?
ARCH|                              s_stage2Result :
ARCH|                              ((shifterMode == 0)||(shifterMode == 1)) ?
ARCH|                              {s_stage2Result[22:0],s_stage3ShiftIn} :
ARCH|                              {s_stage3ShiftIn,s_stage2Result[30:8]};
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** Stage 4 of the binary shift tree is defined here                           **
ARCH|   *******************************************************************************/
ARCH|   assign s_stage4ShiftIn = (shifterMode == 1) ?
ARCH|                              s_stage3Result[30:15] :
ARCH|                              (shifterMode == 3) ?
ARCH|                              { 16{s_stage3Result[30]} } :
ARCH|                              (shifterMode == 4) ?
ARCH|                              s_stage3Result[15:0] : 0;
ARCH|
ARCH|   assign s_stage4Result  = (shiftAmount[4]==0) ?
ARCH|                              s_stage3Result :
ARCH|                              ((shifterMode == 0)||(shifterMode == 1)) ?
ARCH|                              {s_stage3Result[14:0],s_stage4ShiftIn} :
ARCH|                              {s_stage4ShiftIn,s_stage3Result[30:16]};
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** The result is assigned here                                                **
ARCH|   *******************************************************************************/
ARCH|   assign result = s_stage4Result;
ARCH|
ARCH|endmodule
ENDCASE

