CASE Multiplier w=1 mode=twosComplement
LANG VHDL
HDLNAME Multiplier
SYNTH 1
SUPP 1
DIR vhdl/arith/
INLINED 0
SUPPORTED 1
GENTIME 0
PARAMKEY -1 name=nrOfBits int=1
PARAMKEY -2 name=calcBits int=1
PARAMKEY -3 name=unsignedMultiplier int=1
PARAM calcBits = 2
PARAM nrOfBits = 1
PARAM unsignedMultiplier = 1
PARAMEMPTY 0
PORT inputA bits=-1 pin=0 clock=0 pulldown=1
PORT inputB bits=-1 pin=1 clock=0 pulldown=1
PORT carryIn bits=-1 pin=3 clock=0 pulldown=1
PORT multLow bits=-1 pin=2 clock=0 pulldown=1
PORT multHigh bits=-1 pin=4 clock=0 pulldown=1
