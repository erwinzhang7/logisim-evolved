WIRE s_stage0ShiftIn bits=1
FUNC|/*******************************************************************************
FUNC|** ShifterMode represents when:                                               **
FUNC|** 0 : Logical Shift Left                                                     **
FUNC|** 1 : Rotate Left                                                            **
FUNC|** 2 :                                                                        **
FUNC|** Logical Shift Right                                                        **
FUNC|** 3 : Arithmetic Shift Right                                                 **
FUNC|** 4 : Rotate Right                                                           **
FUNC|*******************************************************************************/
FUNC|
FUNC|/*******************************************************************************
FUNC|** Stage 0 of the binary shift tree is defined here                           **
FUNC|*******************************************************************************/
FUNC|assign s_stage0ShiftIn = ((shifterMode == 1) || (shifterMode == 3))
FUNC|     ? dataA[shifterMode] : (1 == 4) ? dataA[0] : 0;
FUNC|
FUNC|assign s_stage0Result  = (shiftAmount == 0)
FUNC|     ? dataA
FUNC|     : ((shifterMode == 0) || (shifterMode == 1))
FUNC|        ? {dataA[0:0],s_stage0ShiftIn}
FUNC|        : {s_stage0ShiftIn,dataA[1:1]};
FUNC|
FUNC|
FUNC|
FUNC|/*******************************************************************************
FUNC|** The result is assigned here                                                **
FUNC|*******************************************************************************/
FUNC|assign result = s_stage0Result;
