ARCH|   *******************************************************************************/
ARCH|   assign s_stage5ShiftIn = (shifterMode == 1) ?
ARCH|                              s_stage4Result[32:1] :
ARCH|                              (shifterMode == 3) ?
ARCH|                              { 32{s_stage4Result[32]} } :
ARCH|                              (shifterMode == 4) ?
