ARCH|   input [nrOfBits-1:0] dataB;
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** The outputs are defined here                                               **
ARCH|   *******************************************************************************/
ARCH|   output aEqualsB;
ARCH|   output aGreaterThanB;
ARCH|   output aLessThanB;
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** The wires are defined here                                                 **
ARCH|   *******************************************************************************/
ARCH|   wire s_signedGreater;
ARCH|   wire s_signedLess;
ARCH|   wire s_unsignedGreater;
ARCH|   wire s_unsignedLess;
ARCH|
ARCH|   /*******************************************************************************
ARCH|   ** The module functionality is described here                                 **
ARCH|   *******************************************************************************/
ARCH|   assign s_signedLess      = ($signed(dataA) < $signed(dataB));
ARCH|   assign s_unsignedLess    = (dataA < dataB);
ARCH|   assign s_signedGreater   = ($signed(dataA) > $signed(dataB));
ARCH|   assign s_unsignedGreater = (dataA > dataB);
