CASE Shifter w=2 shift=ll
LANG VHDL
HDLNAME Shifter_2_bit
SYNTH 1
SUPP 1
DIR vhdl/arith/
INLINED 0
SUPPORTED 1
GENTIME 1
PARAMKEY -1 name=shifterMode int=1
PARAM shifterMode = 0
PARAMEMPTY 0
PORT dataA bits=2 pin=0 clock=0 pulldown=1
PORT shiftAmount bits=1 pin=1 clock=0 pulldown=1
PORT result bits=2 pin=2 clock=0 pulldown=1
PORTDIR input dataA,shiftAmount
PORTDIR output result
PORTDIR inout 
WIRE s_stage0Result bits=2
WIRE s_stage0ShiftIn bits=1
FUNC|--------------------------------------------------------------------------------
FUNC|-- ShifterMode represents when:                                               --
FUNC|-- 0 : Logical Shift Left                                                     --
FUNC|-- 1 : Rotate Left                                                            --
FUNC|-- 2 :                                                                        --
FUNC|-- Logical Shift Right                                                        --
FUNC|-- 3 : Arithmetic Shift Right                                                 --
FUNC|-- 4 : Rotate Right                                                           --
FUNC|--------------------------------------------------------------------------------
FUNC|
FUNC|--------------------------------------------------------------------------------
FUNC|-- Stage 0 of the binary shift tree is defined here                           --
FUNC|--------------------------------------------------------------------------------
FUNC|s_stage0ShiftIn <= dataA(1) WHEN shifterMode = 1 OR shifterMode = 3 ELSE
FUNC|                   dataA(0) WHEN shifterMode = 4 ELSE '0';
FUNC|
FUNC|s_stage0Result  <= dataA
FUNC|
FUNC|                      WHEN shiftAmount = '0' ELSE
FUNC|                   dataA(0 DOWNTO 0)&s_stage0ShiftIn
FUNC|                      WHEN shifterMode = 0 OR shifterMode = 1 ELSE
FUNC|                   s_stage0ShiftIn&dataA( 1 DOWNTO 1 );
FUNC|
FUNC|
FUNC|--------------------------------------------------------------------------------
FUNC|-- The result is assigned here                                                --
FUNC|--------------------------------------------------------------------------------
FUNC|result <= s_stage0Result;
FUNC|
