CASE Adder w=4
LANG VHDL
HDLNAME Adder
SYNTH 1
SUPP 1
DIR vhdl/arith/
INLINED 0
SUPPORTED 1
GENTIME 0
PARAMKEY -2 name=extendedBits int=1
PARAMKEY -1 name=nrOfBits int=1
PARAM extendedBits = 5
PARAM nrOfBits = 4
PARAMEMPTY 0
PORT dataA bits=-1 pin=0 clock=0 pulldown=1
PORT dataB bits=-1 pin=1 clock=0 pulldown=1
PORT carryIn bits=1 pin=3 clock=0 pulldown=1
PORT result bits=-1 pin=2 clock=0 pulldown=1
PORT carryOut bits=1 pin=4 clock=0 pulldown=1
PORTDIR input dataA,dataB,carryIn
PORTDIR output result,carryOut
PORTDIR inout 
WIRE s_extendedDataA bits=-2
WIRE s_extendedDataB bits=-2
WIRE s_sumResult bits=-2
FUNC|
FUNC|s_extendedDataA <= "0"&dataA;
FUNC|s_extendedDataB <= "0"&dataB;
FUNC|s_sumResult     <= std_logic_vector(unsigned(s_extendedDataA) +
FUNC|                                     unsigned(s_extendedDataB) +
FUNC|                                     (""&carryIn));
FUNC|
FUNC|result   <= s_sumResult( (nrOfBits-1) DOWNTO 0 );
FUNC|carryOut <= s_sumResult(extendedBits-1);
FUNC|
