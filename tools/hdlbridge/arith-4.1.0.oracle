LANG VHDL
HDLNAME Shifter_33_bit
SYNTH 1
SUPP 1
DIR vhdl/arith/
INLINED 0
SUPPORTED 1
GENTIME 1
PARAMKEY -1 name=shifterMode int=1
PARAM shifterMode = 0
PARAMEMPTY 0
PORT dataA bits=33 pin=0 clock=0 pulldown=1
PORT shiftAmount bits=6 pin=1 clock=0 pulldown=1
PORT result bits=33 pin=2 clock=0 pulldown=1
PORTDIR input dataA,shiftAmount
PORTDIR output result
PORTDIR inout 
WIRE s_stage0Result bits=33
WIRE s_stage0ShiftIn bits=1
WIRE s_stage1Result bits=33
WIRE s_stage1ShiftIn bits=2
WIRE s_stage2Result bits=33
WIRE s_stage2ShiftIn bits=4
WIRE s_stage3Result bits=33
WIRE s_stage3ShiftIn bits=8
WIRE s_stage4Result bits=33
WIRE s_stage4ShiftIn bits=16
WIRE s_stage5Result bits=33
WIRE s_stage5ShiftIn bits=32
FUNC|--------------------------------------------------------------------------------
FUNC|-- ShifterMode represents when:                                               --
FUNC|-- 0 : Logical Shift Left                                                     --
FUNC|-- 1 : Rotate Left                                                            --
FUNC|-- 2 :                                                                        --
FUNC|-- Logical Shift Right                                                        --
FUNC|-- 3 : Arithmetic Shift Right                                                 --
FUNC|-- 4 : Rotate Right                                                           --
FUNC|--------------------------------------------------------------------------------
FUNC|
FUNC|--------------------------------------------------------------------------------
