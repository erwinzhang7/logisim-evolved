FUNC|s_stage0ShiftIn <= dataA(15) WHEN shifterMode = 1 OR shifterMode = 3 ELSE
FUNC|                   dataA(0) WHEN shifterMode = 4 ELSE '0';
FUNC|
FUNC|s_stage0Result  <= dataA
