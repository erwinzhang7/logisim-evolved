ENTITY|LIBRARY ieee;
ENTITY|USE ieee.std_logic_1164.all;
ENTITY|USE ieee.numeric_std.all;
ENTITY|
ENTITY|
ENTITY|ENTITY Adder_64 IS
ENTITY|   GENERIC ( extendedBits : INTEGER;
ENTITY|             nrOfBits     : INTEGER );
ENTITY|   PORT ( carryIn  : IN  std_logic;
