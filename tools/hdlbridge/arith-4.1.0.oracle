ARCH|--==                                                                          ==
ARCH|--== Project   :                                                              ==
ARCH|--== Component : Divider_31                                                   ==
ARCH|--==                                                                          ==
ARCH|--==============================================================================
ARCH|
ARCH|ARCHITECTURE platformIndependent OF Divider_31 IS 
ARCH|
ARCH|--------------------------------------------------------------------------------
ARCH|-- All used signals are defined here                                          --
ARCH|--------------------------------------------------------------------------------
ARCH|   SIGNAL s_divResult        : std_logic_vector( (calcBits - 1) DOWNTO 0 );
ARCH|   SIGNAL s_extendedDividend : std_logic_vector( (calcBits - 1) DOWNTO 0 );
ARCH|   SIGNAL s_modResult        : std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
ARCH|
ARCH|BEGIN
ARCH|
ARCH|   s_extendedDividend(calcBits-1 DOWNTO nrOfBits) <= upper;
ARCH|   s_extendedDividend(nrOfBits-1 DOWNTO 0) <= inputA;
ARCH|   s_divResult <= std_logic_vector(unsigned(s_extendedDividend) / unsigned(inputB))
ARCH|                      WHEN unsignedDivider = 1 ELSE
ARCH|                   std_logic_vector(signed(s_extendedDividend) / signed(inputB));
ARCH|   s_modResult <= std_logic_vector(unsigned(s_extendedDividend) MOD unsigned(inputB))
ARCH|                      WHEN unsignedDivider = 1 ELSE
ARCH|                   std_logic_vector(signed(s_extendedDividend) MOD signed(inputB));
ARCH|   quotient  <= s_divResult(nrOfBits-1 DOWNTO 0);
ARCH|   remainder <= s_modResult(nrOfBits-1 DOWNTO 0);
ARCH|
ARCH|END platformIndependent;
INST|   COMPONENT Divider_31
INST|      GENERIC ( calcBits        : INTEGER;
INST|                nrOfBits        : INTEGER;
INST|                unsignedDivider : INTEGER );
INST|      PORT ( inputA    : IN  std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
INST|             inputB    : IN  std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
INST|             upper     : IN  std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
INST|             quotient  : OUT std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
INST|             remainder : OUT std_logic_vector( (nrOfBits - 1) DOWNTO 0 ) );
INST|   END COMPONENT;
ENDCASE

