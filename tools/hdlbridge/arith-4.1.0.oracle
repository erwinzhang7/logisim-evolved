ARCH|--==============================================================================
ARCH|
ARCH|ARCHITECTURE platformIndependent OF Comparator_16 IS 
ARCH|
ARCH|--------------------------------------------------------------------------------
ARCH|-- All used signals are defined here                                          --
ARCH|--------------------------------------------------------------------------------
ARCH|   SIGNAL s_signedGreater   : std_logic;
ARCH|   SIGNAL s_signedLess      : std_logic;
ARCH|   SIGNAL s_unsignedGreater : std_logic;
ARCH|   SIGNAL s_unsignedLess    : std_logic;
ARCH|
ARCH|BEGIN
ARCH|
ARCH|   s_signedLess      <= '1' WHEN signed(dataA) < signed(dataB) ELSE '0';
ARCH|   s_unsignedLess    <= '1' WHEN unsigned(dataA) < unsigned(dataB) ELSE '0';
ARCH|   s_signedGreater   <= '1' WHEN signed(dataA) > signed(dataB) ELSE '0';
ARCH|   s_unsignedGreater <= '1' WHEN unsigned(dataA) > unsigned(dataB) ELSE '0';
ARCH|
ARCH|   aEqualsB      <= '1' WHEN dataA = dataB ELSE '0';
ARCH|   aGreaterThanB <= s_signedGreater WHEN twosComplement = 1 ELSE s_unsignedGreater;
ARCH|   aLessThanB    <= s_signedLess WHEN twosComplement = 1 ELSE s_unsignedLess;
ARCH|
ARCH|END platformIndependent;
INST|   COMPONENT Comparator_16
INST|      GENERIC ( nrOfBits       : INTEGER;
INST|                twosComplement : INTEGER );
INST|      PORT ( dataA         : IN  std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
INST|             dataB         : IN  std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
INST|             aEqualsB      : OUT std_logic;
INST|             aGreaterThanB : OUT std_logic;
INST|             aLessThanB    : OUT std_logic );
INST|   END COMPONENT;
ENDCASE

