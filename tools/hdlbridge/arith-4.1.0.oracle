ARCH|   s_stage4ShiftIn <= s_stage3Result( 63 DOWNTO 48 ) WHEN shifterMode = 1 ELSE
ARCH|                      (OTHERS => s_stage3Result(3)) WHEN shifterMode = 3 ELSE
ARCH|                      s_stage3Result( 15 DOWNTO 0 ) WHEN shifterMode = 4 ELSE
ARCH|                      (OTHERS => '0');
ARCH|
ARCH|   s_stage4Result  <= s_stage3Result
ARCH|                         WHEN shiftAmount(4) = '0' ELSE
ARCH|                      s_stage3Result( 47 DOWNTO 0 )&s_stage4ShiftIn
ARCH|                         WHEN shifterMode = 0 OR shifterMode = 1 ELSE
ARCH|                      s_stage4ShiftIn&s_stage3Result( 63 DOWNTO 16 );
ARCH|
ARCH|   --------------------------------------------------------------------------------
ARCH|   -- Stage 5 of the binary shift tree is defined here                           --
ARCH|   --------------------------------------------------------------------------------
ARCH|   s_stage5ShiftIn <= s_stage4Result( 63 DOWNTO 32 ) WHEN shifterMode = 1 ELSE
ARCH|                      (OTHERS => s_stage4Result(4)) WHEN shifterMode = 3 ELSE
ARCH|                      s_stage4Result( 31 DOWNTO 0 ) WHEN shifterMode = 4 ELSE
ARCH|                      (OTHERS => '0');
ARCH|
ARCH|   s_stage5Result  <= s_stage4Result
ARCH|                         WHEN shiftAmount(5) = '0' ELSE
ARCH|                      s_stage4Result( 31 DOWNTO 0 )&s_stage5ShiftIn
ARCH|                         WHEN shifterMode = 0 OR shifterMode = 1 ELSE
ARCH|                      s_stage5ShiftIn&s_stage4Result( 63 DOWNTO 32 );
ARCH|
ARCH|   --------------------------------------------------------------------------------
ARCH|   -- The result is assigned here                                                --
ARCH|   --------------------------------------------------------------------------------
ARCH|   result <= s_stage5Result;
ARCH|
ARCH|END platformIndependent;
INST|   COMPONENT Shifter_64_bit
INST|      GENERIC ( shifterMode : INTEGER );
INST|      PORT ( dataA       : IN  std_logic_vector( 63 DOWNTO 0 );
INST|             shiftAmount : IN  std_logic_vector( 5 DOWNTO 0 );
INST|             result      : OUT std_logic_vector( 63 DOWNTO 0 ) );
INST|   END COMPONENT;
ENDCASE

