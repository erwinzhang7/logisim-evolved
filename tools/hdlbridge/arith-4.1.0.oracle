CASE Comparator w=33 mode=twosComplement
LANG Verilog
HDLNAME Comparator
SYNTH 1
SUPP 1
DIR verilog/arith/
INLINED 0
SUPPORTED 1
GENTIME 1
PARAMKEY -1 name=nrOfBits int=1
PARAMKEY -2 name=twosComplement int=1
PARAM nrOfBits = 33
PARAM twosComplement = 1
PARAMEMPTY 0
PORT dataA bits=-1 pin=0 clock=0 pulldown=1
PORT dataB bits=-1 pin=1 clock=0 pulldown=1
PORT aGreaterThanB bits=1 pin=2 clock=0 pulldown=1
PORT aEqualsB bits=1 pin=3 clock=0 pulldown=1
PORT aLessThanB bits=1 pin=4 clock=0 pulldown=1
PORTDIR input dataA,dataB
PORTDIR output aGreaterThanB,aEqualsB,aLessThanB
PORTDIR inout 
WIRE s_signedLess bits=1
WIRE s_unsignedLess bits=1
WIRE s_signedGreater bits=1
WIRE s_unsignedGreater bits=1
FUNC|assign s_signedLess      = ($signed(dataA) < $signed(dataB));
FUNC|assign s_unsignedLess    = (dataA < dataB);
FUNC|assign s_signedGreater   = ($signed(dataA) > $signed(dataB));
FUNC|assign s_unsignedGreater = (dataA > dataB);
FUNC|
FUNC|assign aEqualsB      = (dataA == dataB);
FUNC|assign aGreaterThanB = (twosComplement==1) ? s_signedGreater : s_unsignedGreater;
FUNC|assign aLessThanB    = (twosComplement==1) ? s_signedLess : s_unsignedLess;
FUNC|
