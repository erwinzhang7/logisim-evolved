FUNC|--------------------------------------------------------------------------------
FUNC|s_stage2ShiftIn <= s_stage1Result( 15 DOWNTO 12 ) WHEN shifterMode = 1 ELSE
FUNC|                   (OTHERS => s_stage1Result(1)) WHEN shifterMode = 3 ELSE
FUNC|                   s_stage1Result( 3 DOWNTO 0 ) WHEN shifterMode = 4 ELSE
FUNC|                   (OTHERS => '0');
FUNC|
FUNC|s_stage2Result  <= s_stage1Result
FUNC|                      WHEN shiftAmount(2) = '0' ELSE
FUNC|                   s_stage1Result( 11 DOWNTO 0 )&s_stage2ShiftIn
FUNC|                      WHEN shifterMode = 0 OR shifterMode = 1 ELSE
FUNC|                   s_stage2ShiftIn&s_stage1Result( 15 DOWNTO 4 );
FUNC|
FUNC|
FUNC|--------------------------------------------------------------------------------
FUNC|-- Stage 3 of the binary shift tree is defined here                           --
FUNC|--------------------------------------------------------------------------------
FUNC|s_stage3ShiftIn <= s_stage2Result( 15 DOWNTO 8 ) WHEN shifterMode = 1 ELSE
FUNC|                   (OTHERS => s_stage2Result(2)) WHEN shifterMode = 3 ELSE
FUNC|                   s_stage2Result( 7 DOWNTO 0 ) WHEN shifterMode = 4 ELSE
FUNC|                   (OTHERS => '0');
FUNC|
FUNC|s_stage3Result  <= s_stage2Result
FUNC|                      WHEN shiftAmount(3) = '0' ELSE
FUNC|                   s_stage2Result( 7 DOWNTO 0 )&s_stage3ShiftIn
FUNC|                      WHEN shifterMode = 0 OR shifterMode = 1 ELSE
FUNC|                   s_stage3ShiftIn&s_stage2Result( 15 DOWNTO 8 );
FUNC|
