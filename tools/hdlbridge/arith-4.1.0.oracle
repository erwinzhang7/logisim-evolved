ENTITY|          dataB    : IN  std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
ENTITY|          carryOut : OUT std_logic;
ENTITY|          result   : OUT std_logic_vector( (nrOfBits - 1) DOWNTO 0 ) );
ENTITY|END ENTITY Adder_64;
