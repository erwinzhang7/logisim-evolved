WIRE s_stage0ShiftIn bits=1
WIRE s_stage1Result bits=3
WIRE s_stage1ShiftIn bits=2
FUNC|/*******************************************************************************
FUNC|** ShifterMode represents when:                                               **
FUNC|** 0 : Logical Shift Left                                                     **
FUNC|** 1 : Rotate Left                                                            **
FUNC|** 2 :                                                                        **
FUNC|** Logical Shift Right                                                        **
FUNC|** 3 : Arithmetic Shift Right                                                 **
FUNC|** 4 : Rotate Right                                                           **
FUNC|*******************************************************************************/
FUNC|
FUNC|/*******************************************************************************
FUNC|** Stage 0 of the binary shift tree is defined here                           **
FUNC|*******************************************************************************/
FUNC|assign s_stage0ShiftIn = ((shifterMode == 1) || (shifterMode == 3))
FUNC|     ? dataA[shifterMode] : (2 == 4) ? dataA[0] : 0;
FUNC|
FUNC|assign s_stage0Result  = (shiftAmount == 0)
FUNC|     ? dataA
FUNC|     : ((shifterMode == 0) || (shifterMode == 1))
FUNC|        ? {dataA[1:0],s_stage0ShiftIn}
FUNC|        : {s_stage0ShiftIn,dataA[2:1]};
FUNC|
FUNC|
FUNC|
FUNC|/*******************************************************************************
FUNC|** Stage 1 of the binary shift tree is defined here                           **
FUNC|*******************************************************************************/
FUNC|assign s_stage1ShiftIn = (shifterMode == 1) ?
FUNC|                           s_stage0Result[2:1] :
FUNC|                           (shifterMode == 3) ?
FUNC|                           { 2{s_stage0Result[2]} } :
FUNC|                           (shifterMode == 4) ?
FUNC|                           s_stage0Result[1:0] : 0;
FUNC|
FUNC|assign s_stage1Result  = (shiftAmount[1]==0) ?
FUNC|                           s_stage0Result :
FUNC|                           ((shifterMode == 0)||(shifterMode == 1)) ?
FUNC|                           {s_stage0Result[0:0],s_stage1ShiftIn} :
FUNC|                           {s_stage1ShiftIn,s_stage0Result[2:2]};
FUNC|
FUNC|
FUNC|
