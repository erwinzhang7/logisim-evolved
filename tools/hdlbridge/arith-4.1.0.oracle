PORT aLessThanB bits=1 pin=4 clock=0 pulldown=1
PORTDIR input dataA,dataB
PORTDIR output aGreaterThanB,aEqualsB,aLessThanB
PORTDIR inout 
FUNC|
FUNC|aEqualsB <= dataA XNOR dataB;
FUNC|aLessThanB <= dataA AND NOT(dataB) WHEN twosComplement = 1 ELSE NOT(dataA) AND dataB;
