ARCH|   assign aGreaterThanB = (twosComplement==1) ? s_signedGreater : s_unsignedGreater;
ARCH|   assign aLessThanB    = (twosComplement==1) ? s_signedLess : s_unsignedLess;
ARCH|
ARCH|endmodule
ENDCASE

