ARCH|   aGreaterThanB <= s_signedGreater WHEN twosComplement = 1 ELSE s_unsignedGreater;
ARCH|   aLessThanB    <= s_signedLess WHEN twosComplement = 1 ELSE s_unsignedLess;
ARCH|
ARCH|END platformIndependent;
INST|   COMPONENT Comparator_64
INST|      GENERIC ( nrOfBits       : INTEGER;
INST|                twosComplement : INTEGER );
INST|      PORT ( dataA         : IN  std_logic_vector( (nrOfBits - 1) DOWNTO 0 );
