ARCH|   s_unsignedLess    <= '1' WHEN unsigned(dataA) < unsigned(dataB) ELSE '0';
ARCH|   s_signedGreater   <= '1' WHEN signed(dataA) > signed(dataB) ELSE '0';
ARCH|   s_unsignedGreater <= '1' WHEN unsigned(dataA) > unsigned(dataB) ELSE '0';
ARCH|
