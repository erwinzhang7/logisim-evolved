PORTDIR output result,borrowOut
PORTDIR inout 
WIRE s_extendeddataA bits=-2
WIRE s_extendeddataB bits=-2
WIRE s_sumresult bits=-2
WIRE n_bIn bits=1
WIRE s_carry bits=1
FUNC|assign n_bIn = ~borrowIn;
FUNC|assign {s_carry,result} = dataA + ~(dataB) + n_bIn;
FUNC|assign borrowOut        = ~s_carry;
FUNC|
